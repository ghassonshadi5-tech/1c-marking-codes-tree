&AtClient
Procedure КнопкаСформировать(Команда)

    // Check: is the aggregation date entered?
    Если Object.ДатаАгрегации = Дата('00010101') Тогда
        Сообщить("❌ Please enter the aggregation date");
        Возврат;
    КонецЕсли;

    // Notification: building started
    Сообщить("⏳ Building tree for date: " + Формат(Object.ДатаАгрегации, "ДФ=dd.MM.yyyy"));

    // Call server procedure
    ПостроитьДеревоНаСервере();

КонецПроцедуры


&AtServer
Procedure ПостроитьДеревоНаСервере()

    // Re-check on server
    Если Object.ДатаАгрегации = Дата('00010101') Тогда
        Возврат;
    КонецЕсли;

    // Fetch data from database
    Результат = СформироватьНаСервере(Object.ДатаАгрегации);

    // No data - exit
    Если Результат.Количество() = 0 Тогда
        Сообщить("⚠️ No data for the selected date");
        Возврат;
    КонецЕсли;

    // Build tree on the form
    ПостроитьДерево(Результат);
    Сообщить("✅ Tree built successfully!");

КонецПроцедуры


&AtServer
Function СформироватьНаСервере(ДатаАгрегации)

    // Day boundaries
    НачалоДня = НачалоДня(ДатаАгрегации);
    КонецДня = КонецДня(ДатаАгрегации);

    // Query: fetch parents and their children
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
        | Родитель.КодАгрегации КАК КодОтца,
        | Родитель.КодМаркировки КАК КодСына,
        | Родитель.ДатаАгрегации КАК ДатаАгрегации,
        | Родитель.Уровень КАК Уровень,
        | Родитель.Линия КАК Линия
        |ИЗ
        | РегистрСведений.демо_АгрегацияКодовМаркировки КАК Родитель
        |ГДЕ
        | Родитель.ДатаАгрегации МЕЖДУ &НачалоДня И &КонецДня
        | И Родитель.КодАгрегации В (
        | ВЫБРАТЬ РАЗЛИЧНЫЕ
        | демо_АгрегацияКодовМаркировки.КодАгрегации
        | ИЗ
        | РегистрСведений.демо_АгрегацияКодовМаркировки КАК демо_АгрегацияКодовМаркировки
        | ГДЕ
        | демо_АгрегацияКодовМаркировки.ДатаАгрегации МЕЖДУ &НачалоДня И &КонецДня
        | И демо_АгрегацияКодовМаркировки.КодАгрегации ПОДОБНО ""(00)%"" 
        | )
        |УПОРЯДОЧИТЬ ПО
        | КодОтца,
        | КодСына";

    Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
    Запрос.УстановитьПараметр("КонецДня", КонецДня);

    // Execute query with error handling
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
    Исключение
        Сообщить("❌ Query error: " + ОписаниеОшибки());
        Возврат Новый Массив;
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    // No data - return empty array
    Если Выборка.Количество() = 0 Тогда
        Возврат Новый Массив;
    КонецЕсли;

    // Collect child codes for nomenclature lookup
    МассивКодов = Новый Массив;

    Пока Выборка.Следующий() Цикл
        МассивКодов.Добавить(Выборка.КодСына);
    КонецЦикла;

    // Get map: code -> nomenclature
    СоответствиеНоменклатур = ПолучитьНоменклатуруПоКодам(МассивКодов);

    // Build result
    Результат = Новый Массив;
    Выборка.Сбросить();

    Пока Выборка.Следующий() Цикл

        СтрокаРезультата = Новый Структура;

        СтрокаРезультата.Вставить("КодОтца", Выборка.КодОтца);
        СтрокаРезультата.Вставить("КодСына", Выборка.КодСына);
        СтрокаРезультата.Вставить("ДатаАгрегации", Выборка.ДатаАгрегации);
        СтрокаРезультата.Вставить("Уровень", Выборка.Уровень);
        СтрокаРезультата.Вставить("Линия", Выборка.Линия);

        Номенклатура = СоответствиеНоменклатур.Получить(Выборка.КодСына);

        Если Номенклатура = Неопределено Тогда
            Номенклатура = "";
        КонецЕсли;

        СтрокаРезультата.Вставить("Номенклатура", Номенклатура);
        Результат.Добавить(СтрокаРезультата);

    КонецЦикла;

    Возврат Результат;

КонецФункции


&AtServer
Function ПолучитьНоменклатуруПоКодам(МассивКодов)

    Соответствие = Новый Соответствие;
    МассивGTIN = Новый Массив;

    // Extract GTIN from each code
    Для каждого Код Из МассивКодов Цикл

        GTIN = ИзвлечьGTINИзКодаGS1(Код);

        Если Не ПустаяСтрока(GTIN) Тогда
            МассивGTIN.Добавить(GTIN);
            Соответствие.Вставить(Код, GTIN);
        КонецЕсли;

    КонецЦикла;

    // No GTIN - return empty map
    Если МассивGTIN.Количество() = 0 Тогда
        Возврат Новый Соответствие;
    КонецЕсли;

    // Query: find nomenclature by barcodes
    Запрос = Новый Запрос;
    Запрос.Текст = "
        |ВЫБРАТЬ
        | ШтрихкодыНоменклатуры.Штрихкод КАК GTIN,
        | ШтрихкодыНоменклатуры.Номенклатура.Наименование КАК Номенклатура
        |ИЗ
        | РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
        |ГДЕ
        | ШтрихкодыНоменклатуры.Штрихкод В (&МассивGTIN)";

    Запрос.УстановитьПараметр("МассивGTIN", МассивGTIN);

    Попытка
        РезультатЗапроса = Запрос.Выполнить();
    Исключение
        Сообщить("❌ Error fetching nomenclature: " + ОписаниеОшибки());
        Возврат Новый Соответствие;
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    // Map: GTIN -> Nomenclature
    СоответствиеGTINкНоменклатуре = Новый Соответствие;

    Пока Выборка.Следующий() Цикл
        СоответствиеGTINкНоменклатуре.Вставить(Выборка.GTIN, Выборка.Номенклатура);
    КонецЦикла;

    // Map: Code -> Nomenclature
    Результат = Новый Соответствие;

    Для каждого Ключ Из Соответствие Цикл

        GTIN = Ключ.Значение;
        Номенклатура = СоответствиеGTINкНоменклатуре.Получить(GTIN);

        Если Номенклатура = Неопределено Тогда
            Номенклатура = "";
        КонецЕсли;

        Результат.Вставить(Ключ.Ключ, Номенклатура);

    КонецЦикла;

    Возврат Результат;

КонецФункции


&AtServer
Function ИзвлечьGTINИзКодаGS1(Код)

    // Empty code
    Если ПустаяСтрока(Код) Тогда
        Возврат "";
    КонецЕсли;

    // GS1 format: (01)GTIN(21)SERIAL
    Поз1 = Найти(Код, "(01)");

    Если Поз1 > 0 Тогда

        Поз2 = Найти(Код, "(21)");

        Если Поз2 > 0 Тогда

            GTIN = Сред(Код, Поз1 + 4, Поз2 - (Поз1 + 4));
            GTIN = СокрЛП(GTIN);

            // Remove leading zero
            Если Лев(GTIN, 1) = "0" Тогда
                GTIN = Сред(GTIN, 2);
            КонецЕсли;

            Возврат GTIN;

        КонецЕсли;

    КонецЕсли;

    // Fallback: positions 3-16
    Если СтрДлина(Код) >= 16 Тогда

        GTIN = Сред(Код, 3, 14);
        GTIN = СокрЛП(GTIN);

        Если Лев(GTIN, 1) = "0" Тогда
            GTIN = Сред(GTIN, 2);
        КонецЕсли;

        Возврат GTIN;

    КонецЕсли;

    Возврат Код;

КонецФункции


&AtServer
Procedure ПостроитьДерево(Результат)

    // CLEAR: clear the tree before building
    Object.ДеревоОсновное.ПолучитьЭлементы().Очистить();

    // Map: FatherCode -> Children array
    СоответствиеДетей = Новый Соответствие;

    Для каждого СтрокаДанных Из Результат Цикл

        МассивДетей = СоответствиеДетей.Получить(СтрокаДанных.КодОтца);

        Если МассивДетей = Неопределено Тогда
            МассивДетей = Новый Массив;
            СоответствиеДетей.Вставить(СтрокаДанных.КодОтца, МассивДетей);
        КонецЕсли;

        МассивДетей.Добавить(СтрокаДанных);

    КонецЦикла;

    // List of parents
    МассивОтцов = Новый Массив;

    Для каждого КлючЗначение Из СоответствиеДетей Цикл

        КодОтца = КлючЗначение.Ключ;
        МассивДетей = КлючЗначение.Значение;

        НоменклатураОтца = "";
        ДатаОтца = Дата('00010101');

        // Father's nomenclature from first child
        Если МассивДетей.Количество() > 0 Тогда
            НоменклатураОтца = МассивДетей[0].Номенклатура;
            ДатаОтца = МассивДетей[0].ДатаАгрегации;
        КонецЕсли;

        СтруктураОтца = Новый Структура;

        СтруктураОтца.Вставить("КодОтца", КодОтца);
        СтруктураОтца.Вставить("Номенклатура", НоменклатураОтца);
        СтруктураОтца.Вставить("ДатаАгрегации", ДатаОтца);
        СтруктураОтца.Вставить("Дети", МассивДетей);

        МассивОтцов.Добавить(СтруктураОтца);

    КонецЦикла;

    // BUILD: build the tree
    Для каждого Отец Из МассивОтцов Цикл

        УзелОтца = Object.ДеревоОсновное.ПолучитьЭлементы().Добавить();

        УзелОтца.Номенклатура = Отец.Номенклатура;
        УзелОтца.КодМаркировки = Отец.КодОтца;
        УзелОтца.ДатаАгрегации = Отец.ДатаАгрегации;
        УзелОтца.Уровень = "Аб";

        Дети = Отец.Дети;

        // Add children
        Для каждого СтрокаДанных Из Дети Цикл

            УзелСына = УзелОтца.ПолучитьЭлементы().Добавить();

            УзелСына.Номенклатура = " - " + СтрокаДанных.Номенклатура;
            УзелСына.КодМаркировки = СтрокаДанных.КодСына;
            УзелСына.КодАгрегации = СтрокаДанных.КодОтца;
            УзелСына.ДатаАгрегации = СтрокаДанных.ДатаАгрегации;
            УзелСына.Уровень = СтрокаДанных.Уровень;
            УзелСына.Линия = СтрокаДанных.Линия;

        КонецЦикла;

    КонецЦикла;

КонецПроцедуры


// ============================================================================
// 2. MOVE PARENT WITH CHILDREN
// ============================================================================

&AtClient
Procedure КнопкаПереместить(Команда)

    // Get current row in the tree
    ТекущаяСтрока = Элементы.ДеревоОсновное.ТекущаяСтрока;

    Если ТекущаяСтрока = Неопределено Тогда
        Сообщить("❌ No item selected in the tree!");
        Возврат;
    КонецЕсли;

    // Get row data
    ДанныеСтроки = Элементы.ДеревоОсновное.ДанныеСтроки(ТекущаяСтрока);

    Если ДанныеСтроки = Неопределено Тогда
        Сообщить("❌ Cannot read item data!");
        Возврат;
    КонецЕсли;

    // Prepare father data
    ДанныеПереноса = Новый Структура;
    ДанныеПереноса.Вставить("КодМаркировки", ДанныеСтроки.КодМаркировки);
    ДанныеПереноса.Вставить("Номенклатура",  ДанныеСтроки.Номенклатура);
    ДанныеПереноса.Вставить("ДатаАгрегации", ДанныеСтроки.ДатаАгрегации);
    ДанныеПереноса.Вставить("Линия",         ДанныеСтроки.Линия);

    // Collect children
    МассивДетей = Новый Массив;
    Дети = ДанныеСтроки.ПолучитьЭлементы();

    Если Дети <> Неопределено Тогда

        Для каждого Ребенок Из Дети Цикл

            СтруктураРебенка = Новый Структура;
            СтруктураРебенка.Вставить("КодМаркировки", Ребенок.КодМаркировки);
            СтруктураРебенка.Вставить("Номенклатура",  Ребенок.Номенклатура);
            СтруктураРебенка.Вставить("ДатаАгрегации", Ребенок.ДатаАгрегации);
            СтруктураРебенка.Вставить("Линия",         Ребенок.Линия);

            МассивДетей.Добавить(СтруктураРебенка);

        КонецЦикла;

    КонецЕсли;

    ДанныеПереноса.Вставить("МассивДетей", МассивДетей);

    // Call server procedure
    КоличествоДетей = ПеренестиОтцаНаСервере(ДанныеПереноса);

    // Refresh visually
    Попытка
        Элементы.ДеревоОтец.Обновить();
    Исключение
    КонецПопытки;

    Сообщить("✅ Father and " + Строка(КоличествоДетей) + " children moved to the second tree");

КонецПроцедуры


&AtServer
Function ПеренестиОтцаНаСервере(ДанныеПереноса)

    // Clear the second tree
    Object.ДеревоОтец.ПолучитьЭлементы().Очистить();

    // Add father
    НовыйОтец = Object.ДеревоОтец.ПолучитьЭлементы().Добавить();

    НовыйОтец.Номенклатура  = ДанныеПереноса.Номенклатура;
    НовыйОтец.КодМаркировки = ДанныеПереноса.КодМаркировки;
    НовыйОтец.ДатаАгрегации = ДанныеПереноса.ДатаАгрегации;
    НовыйОтец.Линия         = ДанныеПереноса.Линия;

    КоличествоДетей = 0;

    // Add children
    Для каждого Ребенок Из ДанныеПереноса.МассивДетей Цикл

        НовыйРебенок = НовыйОтец.ПолучитьЭлементы().Добавить();

        НовыйРебенок.Номенклатура  = Ребенок.Номенклатура;
        НовыйРебенок.КодМаркировки = Ребенок.КодМаркировки;
        НовыйРебенок.ДатаАгрегации = Ребенок.ДатаАгрегации;
        НовыйРебенок.Линия         = Ребенок.Линия;

        КоличествоДетей = КоличествоДетей + 1;

    КонецЦикла;

    Возврат КоличествоДетей;

КонецФункции


// ============================================================================
// 3. LOAD LEVEL 2 CODES
// ============================================================================

&AtClient
Procedure КнопкаЗагрузитьКоды(Команда)

    Сообщить("⏳ Loading level 2 codes...");

    // Call server procedure
    КоличествоКодов = ЗагрузитьКодыУровня2НаСервере();

    // Refresh visually
    Попытка
        Элементы.ДеревоБезОтца.Обновить();
    Исключение
    КонецПопытки;

    Если КоличествоКодов = 0 Тогда
        Сообщить("⚠️ No codes found");
        Возврат;
    КонецЕсли;

    Сообщить("✅ Added " + Строка(КоличествоКодов) + " codes");

КонецПроцедуры


&AtServer
Function ЗагрузитьКодыУровня2НаСервере()

    // Clear the third tree
    Object.ДеревоБезОтца.ПолучитьЭлементы().Очистить();

    // Fetch data
    МассивКодов = ПолучитьКодыУровня2Данные();

    Если МассивКодов.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;

    Корень = Object.ДеревоБезОтца.ПолучитьЭлементы();

    // Add all codes
    Для каждого Элемент Из МассивКодов Цикл

        НоваяСтрока = Корень.Добавить();

        НоваяСтрока.КодМаркировки = Элемент.Код;
        НоваяСтрока.Номенклатура  = Элемент.Номенклатура;
        НоваяСтрока.ДатаАгрегации = Элемент.ДатаАгрегации;
        НоваяСтрока.Линия         = Элемент.Линия;

    КонецЦикла;

    Возврат МассивКодов.Количество();

КонецФункции


&AtServer
Function ПолучитьКодыУровня2Данные()

    Результат = Новый Массив;

    // Period: last 4 days
    ДатаСегодня = ТекущаяДатаСеанса();
    ДатаНачала = НачалоДня(ДатаСегодня - 4 * 86400);
    ДатаКонца = КонецДня(ДатаСегодня);

    Запрос = Новый Запрос;

    // Query codes without a father
    Запрос.Текст = "
        |ВЫБРАТЬ
        | демо_АгрегацияКодовМаркировки.КодМаркировки КАК КодМаркировки,
        | демо_АгрегацияКодовМаркировки.ДатаАгрегации КАК ДатаАгрегации,
        | демо_АгрегацияКодовМаркировки.Линия КАК Линия
        |ИЗ
        | РегистрСведений.демо_АгрегацияКодовМаркировки КАК демо_АгрегацияКодовМаркировки
        |ГДЕ
        | демо_АгрегацияКодовМаркировки.ДатаАгрегации МЕЖДУ &ДатаНачала И &ДатаКонца
        | И демо_АгрегацияКодовМаркировки.КодАгрегации = ""0""
        |УПОРЯДОЧИТЬ ПО КодМаркировки";

    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаКонца", ДатаКонца);

    Попытка

        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();

        Пока Выборка.Следующий() Цикл

            СтруктураКода = Новый Структура;

            СтруктураКода.Вставить("Код", Выборка.КодМаркировки);
            СтруктураКода.Вставить("ДатаАгрегации", Выборка.ДатаАгрегации);
            СтруктураКода.Вставить("Линия", Выборка.Линия);
            СтруктураКода.Вставить("Номенклатура", "");

            Результат.Добавить(СтруктураКода);

        КонецЦикла;

    Исключение
        Сообщить("❌ Query error: " + ОписаниеОшибки());
    КонецПопытки;

    // Get nomenclature
    Если Результат.Количество() > 0 Тогда

        МассивКодов = Новый Массив;

        Для каждого Элемент Из Результат Цикл
            МассивКодов.Добавить(Элемент.Код);
        КонецЦикла;

        СоответствиеНоменклатур = ПолучитьНоменклатуруПоКодам(МассивКодов);

        Для каждого Элемент Из Результат Цикл

            Номенклатура = СоответствиеНоменклатур.Получить(Элемент.Код);

            Если Номенклатура = Неопределено Тогда
                Номенклатура = "";
            КонецЕсли;

            Элемент.Номенклатура = Номенклатура;

        КонецЦикла;

    КонецЕсли;

    Возврат Результат;

КонецФункции


// ============================================================================
// 4. LINK CHILDREN WITH PARENT
// ============================================================================

&AtClient
Procedure КнопкаСвязать(Команда)

    // Selected rows in the third tree
    МассивВыбранныхСтрок = Элементы.ДеревоБезОтца.ВыделенныеСтроки;

    Если МассивВыбранныхСтрок.Количество() = 0 Тогда
        Сообщить("❌ No item selected in the third tree!");
        Возврат;
    КонецЕсли;

    // Collect selected codes
    МассивКодовДляПереноса = Новый Массив;

    Для каждого Строка Из МассивВыбранныхСтрок Цикл

        ДанныеСына = Элементы.ДеревоБезОтца.ДанныеСтроки(Строка);

        Если ДанныеСына <> Неопределено Тогда

            СтруктураКода = Новый Структура;

            СтруктураКода.Вставить("Код", ДанныеСына.КодМаркировки);
            СтруктураКода.Вставить("Номенклатура", ДанныеСына.Номенклатура);
            СтруктураКода.Вставить("ДатаАгрегации", ДанныеСына.ДатаАгрегации);
            СтруктураКода.Вставить("Линия", ДанныеСына.Линия);

            МассивКодовДляПереноса.Добавить(СтруктураКода);

        КонецЕсли;

    КонецЦикла;

    Если МассивКодовДляПереноса.Количество() = 0 Тогда
        Сообщить("❌ No valid codes found!");
        Возврат;
    КонецЕсли;

    // Get father data
    ДанныеОтца = ПолучитьДанныеОтцаНаСервере();

    Если ДанныеОтца = Неопределено Тогда
        Сообщить("❌ No father found in the second tree!");
        Возврат;
    КонецЕсли;

    // Question text
    ТекстВопроса = "Link " + Строка(МассивКодовДляПереноса.Количество()) + " children to the father?";

    // Data for the dialog
    ДанныеСвязи = Новый Структура;
    ДанныеСвязи.Вставить("МассивКодов", МассивКодовДляПереноса);
    ДанныеСвязи.Вставить("КодОтца", ДанныеОтца.КодОтца);
    ДанныеСвязи.Вставить("ДатаОтца", ДанныеОтца.ДатаОтца);

    // Show confirmation dialog
    ПоказатьВопрос(
        Новый ОписаниеОповещения("ПослеПодтвержденияСвязи", ЭтотОбъект, ДанныеСвязи),
        ТекстВопроса,
        РежимДиалогаВопрос.ДаНет
    );

КонецПроцедуры


&AtServer
Function ПолучитьДанныеОтцаНаСервере()

    КореньВторой = Object.ДеревоОтец.ПолучитьЭлементы();

    Если КореньВторой.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Father is always the first node
    УзелОтца = КореньВторой[0];

    Результат = Новый Структура;
    Результат.Вставить("КодОтца", УзелОтца.КодМаркировки);
    Результат.Вставить("ДатаОтца", УзелОтца.ДатаАгрегации);

    Возврат Результат;

КонецФункции


&AtClient
Procedure ПослеПодтвержденияСвязи(РезультатВопроса, ДополнительныеПараметры) Экспорт

    // If user cancelled
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Сообщить("❌ Link operation cancelled.");
        Возврат;
    КонецЕсли;

    // Extract parameters
    МассивКодов = ДополнительныеПараметры.МассивКодов;
    КодОтца = ДополнительныеПараметры.КодОтца;
    ДатаОтца = ДополнительныеПараметры.ДатаОтца;

    // Link on server
    Результат = СвязатьСыновейСОтцомНаСервере(МассивКодов, КодОтца, ДатаОтца);

    Если Результат.Успех Тогда

        // Refresh trees
        ОбновитьДеревьяПослеСвязиНаСервере(МассивКодов, ДатаОтца);

        Попытка
            Элементы.ДеревоОтец.Обновить();
            Элементы.ДеревоБезОтца.Обновить();
        Исключение
        КонецПопытки;

        Сообщить("✅ " + Результат.Сообщение);

    Иначе

        Сообщить("❌ " + Результат.Сообщение);

    КонецЕсли;

КонецПроцедуры


&AtServer
Procedure ОбновитьДеревьяПослеСвязиНаСервере(МассивКодов, ДатаОтца)

    // 1) Remove from the third tree
    КореньТретьей = Object.ДеревоБезОтца.ПолучитьЭлементы();

    Для каждого Элемент Из МассивКодов Цикл

        КодСына = Элемент.Код;

        Для каждого СтрокаТретьей Из КореньТретьей Цикл

            Если СтрокаТретьей.КодМаркировки = КодСына Тогда
                КореньТретьей.Удалить(СтрокаТретьей);
                Прервать;
            КонецЕсли;

        КонецЦикла;

    КонецЦикла;

    // 2) Add to the second tree under father
    КореньВторой = Object.ДеревоОтец.ПолучитьЭлементы();

    Если КореньВторой.Количество() > 0 Тогда

        УзелОтца = КореньВторой[0];

        Для каждого Элемент Из МассивКодов Цикл

            НовыйСын = УзелОтца.ПолучитьЭлементы().Добавить();

            НовыйСын.КодМаркировки = Элемент.Код;
            НовыйСын.Номенклатура  = " - " + Элемент.Номенклатура;
            НовыйСын.ДатаАгрегации = ДатаОтца;
            НовыйСын.Линия         = Элемент.Линия;

        КонецЦикла;

    КонецЕсли;

КонецПроцедуры


&AtServer
Function СвязатьСыновейСОтцомНаСервере(МассивКодов, КодОтца, ДатаОтца)

    Результат = Новый Структура;

    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", "");

    КоличествоУспешных = 0;

    // Process each code
    Для каждого Элемент Из МассивКодов Цикл

        КодСына = Элемент.Код;
        ЛинияСына = Элемент.Линия;
        СвязьВыполнена = Ложь;

        Попытка

            // Read record set
            Набор = РегистрыСведений.демо_АгрегацияКодовМаркировки.СоздатьНаборЗаписей();

            Набор.Отбор.КодМаркировки.Установить(КодСына);
            Набор.Прочитать();

            // Update records with the same line
            Для каждого Запись Из Набор Цикл

                Если Запись.Линия = ЛинияСына Тогда

                    Запись.КодАгрегации = КодОтца;
                    Запись.ДатаАгрегации = ДатаОтца;

                    СвязьВыполнена = Истина;

                КонецЕсли;

            КонецЦикла;

            // Write changes
            Если СвязьВыполнена Тогда

                Набор.Записать();
                КоличествоУспешных = КоличествоУспешных + 1;

            КонецЕсли;

        Исключение
            Сообщить("❌ Error: " + ОписаниеОшибки());
        КонецПопытки;

    КонецЦикла;

    // Result
    Если КоличествоУспешных > 0 Тогда

        Результат.Успех = Истина;
        Результат.Сообщение = "Linked " + Строка(КоличествоУспешных) + " children successfully!";

    Иначе

        Результат.Сообщение = "Failed to link children!";

    КонецЕсли;

    Возврат Результат;

КонецФункции


// ============================================================================
// 5. BARCODE TABLE OPERATIONS
// ============================================================================

&AtClient
Procedure КнопкаПоказатьБаркод(Команда)

    // Selected rows in the first tree
    МассивВыбранныхСтрок = Элементы.ДеревоОсновное.ВыделенныеСтроки;

    Если МассивВыбранныхСтрок.Количество() = 0 Тогда
        Сообщить("❌ Please select one or more items!");
        Возврат;
    КонецЕсли;

    // Collect selected codes (only fathers)
    МассивКодов = Новый Массив;

    Для каждого Строка Из МассивВыбранныхСтрок Цикл

        ДанныеСтроки = Элементы.ДеревоОсновное.ДанныеСтроки(Строка);

        Если ДанныеСтроки <> Неопределено Тогда

            Код = ДанныеСтроки.КодМаркировки;

            // Only father codes
            Если Лев(Код, 4) = "(00)" Тогда

                СтруктураКода = Новый Структура;
                СтруктураКода.Вставить("Код", Код);
                СтруктураКода.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
                СтруктураКода.Вставить("ДатаАгрегации", ДанныеСтроки.ДатаАгрегации);

                МассивКодов.Добавить(СтруктураКода);

            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    // Add on server
    КоличествоДобавлено = ДобавитьБаркодыВТаблицуНаСервере(МассивКодов);

    Попытка
        Элементы.ТаблицаШтрихкодов.Обновить();
    Исключение
    КонецПопытки;

    Сообщить("✅ Added " + Строка(КоличествоДобавлено) + " barcode(s)");

КонецПроцедуры


&AtServer
Function ДобавитьБаркодыВТаблицуНаСервере(МассивКодов)

    КоличествоДобавлено = 0;

    Для каждого Элемент Из МассивКодов Цикл

        Код = Элемент.Код;

        // Check for duplicate
        Существует = Ложь;

        Для каждого СтрокаТаблицы Из Object.ТаблицаШтрихкодов Цикл

            Если СтрокаТаблицы.КодМаркировки = Код Тогда
                Существует = Истина;
                Прервать;
            КонецЕсли;

        КонецЦикла;

        // Add only if no duplicate
        Если Не Существует Тогда

            НоваяСтрока = Object.ТаблицаШтрихкодов.Добавить();

            НоваяСтрока.Номенклатура         = Элемент.Номенклатура;
            НоваяСтрока.КодМаркировки        = Элемент.Код;
            НоваяСтрока.ДатаАгрегации        = Элемент.ДатаАгрегации;
            НоваяСтрока.ИзображениеШтрихкода = Элемент.Код;

            КоличествоДобавлено = КоличествоДобавлено + 1;

        КонецЕсли;

    КонецЦикла;

    Возврат КоличествоДобавлено;

КонецФункции


&AtClient
Procedure КнопкаОчистить(Команда)

    // Confirmation dialog
    ТекстВопроса = "Clear all data from the barcode table?";

    ПоказатьВопрос(
        Новый ОписаниеОповещения("ПослеПодтвержденияОчистки", ЭтотОбъект),
        ТекстВопроса,
        РежимДиалогаВопрос.ДаНет
    );

КонецПроцедуры


&AtClient
Procedure ПослеПодтвержденияОчистки(РезультатВопроса, ДополнительныеПараметры) Экспорт

    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
