// ============================================================================
// 6. DETACH CHILD FROM PARENT
// ============================================================================

&AtClient
Procedure КнопкаОтсоединить(Команда)

    // 1) Get current row in the second tree
    ТекущаяСтрока = Элементы.ДеревоОтец.ТекущаяСтрока;

    Если ТекущаяСтрока = Неопределено Тогда
        Сообщить("❌ Please select a child in the second tree!");
        Возврат;
    КонецЕсли;

    // 2) Ensure the father is not selected
    КореньВторой = Object.ДеревоОтец.ПолучитьЭлементы();

    Если КореньВторой.Количество() = 0 Тогда
        Сообщить("❌ No father in the second tree!");
        Возврат;
    КонецЕсли;

    УзелОтца = КореньВторой[0];

    Если ТекущаяСтрока = УзелОтца Тогда
        Сообщить("❌ Cannot detach the father, please select a child.");
        Возврат;
    КонецЕсли;

    // 3) Collect selected child data
    ДанныеСына = Элементы.ДеревоОтец.ДанныеСтроки(ТекущаяСтрока);

    Если ДанныеСына = Неопределено Тогда
        Сообщить("❌ Cannot read child data!");
        Возврат;
    КонецЕсли;

    СтруктураСына = Новый Структура;
    СтруктураСына.Вставить("КодМаркировки", ДанныеСына.КодМаркировки);
    СтруктураСына.Вставить("Номенклатура",  ДанныеСына.Номенклатура);
    СтруктураСына.Вставить("ДатаАгрегации", ДанныеСына.ДатаАгрегации);
    СтруктураСына.Вставить("Линия",         ДанныеСына.Линия);

    // 4) Perform detach on server
    Результат = ОтсоединитьСынаНаСервере(СтруктураСына);

    Если Не Результат.Успех Тогда
        Сообщить("❌ " + Результат.Сообщение);
        Возврат;
    КонецЕсли;

    // 5) Refresh visually
    Попытка
        Элементы.ДеревоОтец.Обновить();
        Элементы.ДеревоБезОтца.Обновить();
    Исключение
    КонецПопытки;

    Сообщить("✅ " + Результат.Сообщение);

КонецПроцедуры


&AtServer
Function ОтсоединитьСынаНаСервере(СтруктураСына)

    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", "");

    КодСына   = СтруктураСына.КодМаркировки;
    ЛинияСына = СтруктураСына.Линия;

    // 1) Detach child in database
    Попытка

        Набор = РегистрыСведений.демо_АгрегацияКодовМаркировки.СоздатьНаборЗаписей();

        Набор.Отбор.КодМаркировки.Установить(КодСына);
        Набор.Прочитать();

        СвязьНайдена = Ложь;

        Для каждого Запись Из Набор Цикл

            Если Запись.Линия = ЛинияСына Тогда

                Запись.КодАгрегации = "0";
                СвязьНайдена = Истина;

            КонецЕсли;

        КонецЦикла;

        // Record not found
        Если Не СвязьНайдена Тогда
            Результат.Сообщение = "Record not found in the database!";
            Возврат Результат;
        КонецЕсли;

        Набор.Записать();

    Исключение
        Результат.Сообщение = "Save error: " + ОписаниеОшибки();
        Возврат Результат;
    КонецПопытки;

    // 2) Remove child from second tree
    КореньВторой = Object.ДеревоОтец.ПолучитьЭлементы();

    Если КореньВторой.Количество() > 0 Тогда

        УзелОтца = КореньВторой[0];
        ДетиОтца = УзелОтца.ПолучитьЭлементы();

        Для каждого Ребенок Из ДетиОтца Цикл

            Если Ребенок.КодМаркировки = КодСына Тогда
                ДетиОтца.Удалить(Ребенок);
                Прервать;
            КонецЕсли;

        КонецЦикла;

    КонецЕсли;

    // 3) Add child to the third tree
    КореньТретьей = Object.ДеревоБезОтца.ПолучитьЭлементы();

    // Check for duplicate
    Существует = Ложь;

    Для каждого СтрокаТретьей Из КореньТретьей Цикл

        Если СтрокаТретьей.КодМаркировки = КодСына Тогда
            Существует = Истина;
            Прервать;
        КонецЕсли;

    КонецЦикла;

    // Add only if no duplicate
    Если Не Существует Тогда

        НоваяСтрока = КореньТретьей.Добавить();

        НоваяСтрока.КодМаркировки = СтруктураСына.КодМаркировки;
        НоваяСтрока.Номенклатура  = СтруктураСына.Номенклатура;
        НоваяСтрока.ДатаАгрегации = СтруктураСына.ДатаАгрегации;
        НоваяСтрока.Линия         = СтруктураСына.Линия;

    КонецЕсли;

    // 4) Result
    Результат.Успех = Истина;
    Результат.Сообщение = "Child detached and moved to the third tree!";

    Возврат Результат;

КонецФункции