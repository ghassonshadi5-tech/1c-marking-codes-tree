    // Clear on server
    ОчиститьТаблицуШтрихкодовНаСервере();

    Попытка
        Элементы.ТаблицаШтрихкодов.Обновить();
    Исключение
    КонецПопытки;

    Сообщить("✅ Barcode table cleared");

КонецПроцедуры


&AtServer
